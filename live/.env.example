# Copia este archivo como .env en la raíz del proyecto (en el servidor) y rellénalo.
# NUNCA subas el .env a GitHub. Permisos recomendados: chmod 600 .env

# --- Kraken Futures REAL (claves NUEVAS; sin permiso de retirada) ---
KRAKEN_FUTURES_API_KEY=
KRAKEN_FUTURES_API_SECRET=

# --- Kraken Futures DEMO (demo-futures.kraken.com) ---
KRAKEN_DEMO_API_KEY=
KRAKEN_DEMO_API_SECRET=

# --- Telegram (token NUEVO, el anterior está expuesto) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Riesgo (valores por defecto; descomenta para cambiar) ---
# BOT_RISK_PCT=0.01                 # 1% del capital por operación si salta el stop
# BOT_MAX_NOTIONAL_PER_TRADE=500    # USD máximos por operación
# BOT_MAX_TOTAL_NOTIONAL=2500       # USD máximos sumando todas las posiciones
# BOT_MAX_DRAWDOWN_HALT=0.25        # pausa nuevas entradas si cae 25% desde el máximo
# BOT_SYMBOLS=PF_XBTUSD,PF_ETHUSD,PF_SOLUSD,PF_XRPUSD,PF_ADAUSD,PF_LINKUSD,PF_DOGEUSD
